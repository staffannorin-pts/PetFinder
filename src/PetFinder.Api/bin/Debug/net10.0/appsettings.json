{
  "ConnectionStrings": {
    "Default": "Data Source=petfinder.db"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "RequestBodyLogging": {
    "Enabled": true,
    "MaxBodyLength": 2048,
    "AllowedContentTypes": [
      "application/json",
      "text/plain"
    ],
    "AllowedPathPrefixes": [
      "/api"
    ]
  },
  "ApiKeyAuthentication": {
    "HeaderName": "X-API-Key",
    "Keys": []
  },
  "ImageStorage": {
    "BasePath": "storage/images",
    "MaxBytes": 5242880,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
